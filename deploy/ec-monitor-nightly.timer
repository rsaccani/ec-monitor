# 01:30 UTC: the recorder closes the 23:00 hour at midnight and the first hour
# of the new day at 01:00, whose first minutes hold the day's late fixes; the
# database backup of 01:00 is over by 01:00:20.
[Unit]
Description=EC monitor: nightly measures at 01:30 UTC

[Timer]
OnCalendar=*-*-* 01:30:00 UTC
# A run missed while the host was down happens at boot; rerunning a day is safe.
Persistent=true

[Install]
WantedBy=timers.target
