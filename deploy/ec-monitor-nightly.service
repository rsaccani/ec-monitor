# The nightly measures (nightly.py, METHOD.md section 10), as a systemd unit
# pair: the alternative to the crontab line in deploy/README.md. Install as
# root:
#   install -m 644 ec-monitor-nightly.service ec-monitor-nightly.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ec-monitor-nightly.timer
# User, Group and the paths below are an example (service user ecmon, checkout
# /home/ecmon/ec-monitor): set them to yours first.
# Try it once by hand before trusting it unattended:
#   systemctl start ec-monitor-nightly.service; tail ~ecmon/ec-nightly/nightly.log
[Unit]
Description=EC monitor: nightly measures from the raw recording
After=mariadb.service

[Service]
Type=oneshot
User=ecmon
Group=ecmon
WorkingDirectory=/home/ecmon/ec-monitor
# A unit starts with no HOME (the midnight reset of 4 October 2026 failed on
# that). nightly.py finds .env by its own path and needs none, but anything
# it calls should find the right one.
Environment=HOME=/home/ecmon
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
# The batch measured under 500 MB; the cap keeps it from starving the service.
MemoryMax=700M
# flock: never two runs at once, should one overrun into the next.
ExecStart=/usr/bin/flock -n /home/ecmon/ec-nightly/lock /usr/bin/python3 /home/ecmon/ec-monitor/nightly.py
StandardOutput=append:/home/ecmon/ec-nightly/nightly.log
StandardError=append:/home/ecmon/ec-nightly/nightly.log
